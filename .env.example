# ==============================================================================
# KKHM Off-Course Activity Management System — Environment Configuration
# ==============================================================================
# Copy this file to `.env` for local development, or configure these variables
# as GitHub Repository Secrets (Settings -> Secrets and variables -> Actions)
# for automatic free deployment to GitHub Pages.
#
# IMPORTANT: NEVER place the Supabase `service_role` key in frontend code or
# in VITE_* environment variables. Only the public `anon` key belongs here.
# ==============================================================================

# Supabase Project URL (e.g., https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=""

# Supabase Public Anon Key (safe for client-side use with Row Level Security enabled)
VITE_SUPABASE_ANON_KEY=""

# Optional base path override for GitHub Pages subpath hosting (defaults to "./")
VITE_BASE_PATH="./"
